<ContentDialog
    x:Class="QuickTranslator.Views.AppPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickTranslator"
    Title="Manage Excluded Applications"
    PrimaryButtonText="Save Exclusions"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="8"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <Grid Width="460" Height="420" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Search Box -->
        <TextBox x:Name="SearchBox"
                 Grid.Row="0"
                 PlaceholderText="Search by app name or process (e.g. steam, code, game)..."
                 TextChanged="SearchBox_TextChanged">
            <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
            </TextBox.Resources>
        </TextBox>

        <!-- 2. Source Filter Selector (Running vs Installed) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="RunningTabButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,4,0"
                    Click="RunningTabButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="#4ADE80" />
                    <TextBlock x:Name="RunningTabCountText" Text="Running Windows (0)" FontSize="12" />
                </StackPanel>
            </Button>
            <Button x:Name="InstalledTabButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Margin="4,0,0,0"
                    Click="InstalledTabButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71D;" FontSize="11" Foreground="#38BDF8" />
                    <TextBlock x:Name="InstalledTabCountText" Text="Installed Apps (0)" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3. App List Area -->
        <Grid Grid.Row="2">
            <!-- Loading Indicator -->
            <StackPanel x:Name="LoadingPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="8"
                        Visibility="Visible">
                <ProgressRing IsActive="True" Width="28" Height="28" />
                <TextBlock Text="Discovering desktop applications..." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Discovered Apps ListView -->
            <ListView x:Name="AppsListView"
                      Visibility="Collapsed"
                      SelectionMode="Multiple"
                      SelectionChanged="AppsListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- App Icon with FontIcon Fallback -->
                            <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{Binding IconImage}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ExeName}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty State -->
            <TextBlock x:Name="EmptyStateText"
                       Text="No matching applications found."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>

        <!-- 4. Selection Counter -->
        <TextBlock x:Name="SelectedCountText"
                   Grid.Row="3"
                   Text="0 applications selected"
                   FontSize="11"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
    </Grid>
</ContentDialog>
