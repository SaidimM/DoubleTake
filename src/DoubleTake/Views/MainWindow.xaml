<Window
    x:Class="QuickTranslator.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickTranslator"
    Title="DoubleTake">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Top App Header ── -->
        <Border Grid.Row="0" Height="44" Padding="16,0" VerticalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8BD;" FontSize="16" Foreground="#38BDF8" />
                    <TextBlock Text="DoubleTake" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="#1A38BDF8" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="Trigger: Double-tap Ctrl" FontSize="11" Foreground="#38BDF8" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="Running in Background · Tray Enabled" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ── Main Navigation View ── -->
        <NavigationView Grid.Row="1" x:Name="NavView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Translate" Tag="Translate" Icon="Globe" IsSelected="True" />
                <NavigationViewItem Content="History" Tag="History" Icon="Clock" />
            </NavigationView.MenuItems>

            <Grid Margin="24,10,24,24">

                <!-- ═══════════════════════════════════════════════ -->
                <!-- 1. TRANSLATE SCREEN                             -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid x:Name="TranslateView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Language Toolbar -->
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="SourceLangCombo" Grid.Column="0" Width="160" SelectedIndex="0">
                            <ComboBoxItem Content="Auto Detect" Tag="auto" />
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Chinese (Simplified)" Tag="zh-CN" />
                            <ComboBoxItem Content="Japanese" Tag="ja" />
                            <ComboBoxItem Content="Spanish" Tag="es" />
                            <ComboBoxItem Content="French" Tag="fr" />
                            <ComboBoxItem Content="German" Tag="de" />
                            <ComboBoxItem Content="Russian" Tag="ru" />
                            <ComboBoxItem Content="Korean" Tag="ko" />
                        </ComboBox>

                        <Button x:Name="SwapLangButton" Grid.Column="1" Margin="8,0" Click="SwapLangButton_Click">
                            <FontIcon Glyph="&#xE8AB;" FontSize="14" />
                        </Button>

                        <ComboBox x:Name="TargetLangCombo" Grid.Column="2" Width="160" SelectedIndex="2">
                            <ComboBoxItem Content="English" Tag="en" />
                            <ComboBoxItem Content="Chinese (Simplified)" Tag="zh-CN" />
                            <ComboBoxItem Content="Japanese" Tag="ja" />
                            <ComboBoxItem Content="Spanish" Tag="es" />
                            <ComboBoxItem Content="French" Tag="fr" />
                            <ComboBoxItem Content="German" Tag="de" />
                            <ComboBoxItem Content="Russian" Tag="ru" />
                            <ComboBoxItem Content="Korean" Tag="ko" />
                        </ComboBox>

                        <Button x:Name="TranslateButton" Grid.Column="4" Click="TranslateButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8BD;" FontSize="14" Foreground="#38BDF8" />
                                <TextBlock Text="Translate" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Two Cards -->
                    <Grid Grid.Row="1" Margin="0,16,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Source Card -->
                        <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="SourceTextBox" Grid.Row="0" PlaceholderText="Enter or paste text to translate..."
                                         TextWrapping="Wrap" AcceptsReturn="True" BorderThickness="0" Background="Transparent"
                                         TextChanged="SourceTextBox_TextChanged" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <TextBlock x:Name="CharCountText" Text="0 characters" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                        <Button x:Name="PasteButton" Click="PasteButton_Click">
                                            <FontIcon Glyph="&#xE77F;" FontSize="12" />
                                        </Button>
                                        <Button x:Name="ClearSourceButton" Click="ClearSourceButton_Click">
                                            <FontIcon Glyph="&#xE894;" FontSize="12" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Target Card -->
                        <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox x:Name="TargetTextBox" Grid.Row="0" PlaceholderText="Translation will appear here..."
                                         TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" BorderThickness="0" Background="Transparent" />
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                                        <Border Background="#1A38BDF8" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="ActiveEngineTag" Text="Google Engine" FontSize="11" Foreground="#38BDF8" />
                                        </Border>
                                        <ProgressRing x:Name="LoadingRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Button x:Name="CopyTargetButton" Click="CopyTargetButton_Click" HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="12" />
                                            <TextBlock Text="Copy" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Banner -->
                    <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Grid.Column="0" Glyph="&#xE946;" FontSize="15" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Grid.Column="1" Text="Quick Trigger: Highlight text in any application and double-tap Ctrl to pop up DoubleTake instantly!" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="Test Popup" Click="TestPopup_Click" FontSize="11" Padding="10,4" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- 2. HISTORY SCREEN WITH SEARCH & EXPORT          -->
                <!-- ═══════════════════════════════════════════════ -->
                <Grid x:Name="HistoryView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Translation History" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox x:Name="HistorySearchBox" PlaceholderText="Search history..." Width="220" TextChanged="HistorySearchBox_TextChanged" Margin="16,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExportCsvButton" Click="ExportCsvButton_Click" ToolTipService.ToolTip="Export history to CSV spreadsheet">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8E5;" FontSize="12" />
                                    <TextBlock Text="Export CSV" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportMdButton" Click="ExportMdButton_Click" ToolTipService.ToolTip="Export history to Markdown document">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="12" />
                                    <TextBlock Text="Export Markdown" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearHistoryButton" Content="Clear All" Click="ClearHistory_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Notification Banner -->
                    <InfoBar x:Name="HistoryInfoBar" Grid.Row="1" IsOpen="False" Severity="Success" Margin="0,0,0,12" />

                    <!-- History List -->
                    <ListView Grid.Row="2" x:Name="HistoryListView" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Border Background="#1A38BDF8" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding Engine}" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Text="{Binding FormattedTime}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SourceLang}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="➔" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TargetLang}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SourceText}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TranslatedText}" FontSize="14" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Button Tag="{Binding TranslatedText}" Click="HistoryCopy_Click" Padding="8,5" ToolTipService.ToolTip="Copy Translation">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="11" />
                                            </Button>
                                            <Button Tag="{Binding Id}" Click="HistoryDelete_Click" Padding="8,5" ToolTipService.ToolTip="Delete Item">
                                                <FontIcon Glyph="&#xE74D;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- ═══════════════════════════════════════════════ -->
                <!-- 3. SETTINGS & CONFIGURATION SCREEN              -->
                <!-- ═══════════════════════════════════════════════ -->
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="20" Padding="0,0,0,32">

                        <TextBlock Text="Settings &amp; Preferences" FontSize="22" FontWeight="Bold" Margin="0,4,0,4" />

                        <!-- ── SECTION A: 7-ENGINE TRANSLATION PROVIDER DRAWER ── -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Translation Engines &amp; API Keys" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="Configure and test credentials for 7 global &amp; regional translation providers" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" x:Name="ProviderStatusBadge" Background="#1A4ADE80" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="ProviderStatusBadgeText" Text="✓ Ready (Built-in)" FontSize="11" Foreground="#4ADE80" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <!-- Engine Selector -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Active Primary Engine" FontSize="13" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <ComboBox Grid.Column="1" x:Name="EngineSelectorCombo" HorizontalAlignment="Stretch" SelectionChanged="EngineSelectorCombo_SelectionChanged">
                                        <ComboBoxItem Content="Google Translate (Free &amp; Built-in · Global #1)" Tag="Google" />
                                        <ComboBoxItem Content="Bing / Edge Translator (Free &amp; Built-in · Microsoft)" Tag="Bing" />
                                        <ComboBoxItem Content="DeepL API (Global · High Nuance / EU / JP)" Tag="DeepL" />
                                        <ComboBoxItem Content="Baidu Fanyi / 百度翻译 (China #1 · AppID + Key)" Tag="Baidu" />
                                        <ComboBoxItem Content="Naver Papago / 파파고 (South Korea #1 · ClientID + Secret)" Tag="Papago" />
                                        <ComboBoxItem Content="Yandex Translate (Russia &amp; CIS #1 · API Key)" Tag="Yandex" />
                                        <ComboBoxItem Content="Youdao Translate / 网易有道 (China #2 · AppKey + Secret)" Tag="Youdao" />
                                    </ComboBox>
                                </Grid>

                                <!-- Dynamic Credential Panels -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="16">
                                    <StackPanel Spacing="12">

                                        <!-- Panel: Google -->
                                        <StackPanel x:Name="GoogleConfigPanel" Visibility="Visible" Spacing="6">
                                            <TextBlock Text="Google Translate (Built-in)" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                            <TextBlock Text="✓ Ready to use. Powered by Google public neural translation. No API keys required." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Panel: Bing -->
                                        <StackPanel x:Name="BingConfigPanel" Visibility="Collapsed" Spacing="6">
                                            <TextBlock Text="Bing / Edge Translator (Built-in)" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                            <TextBlock Text="✓ Ready to use. Powered by Microsoft Edge translation engine. Fast and reliable globally." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Panel: DeepL -->
                                        <StackPanel x:Name="DeepLConfigPanel" Visibility="Collapsed" Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="DeepL API Configuration" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                                <HyperlinkButton Grid.Column="1" Content="Get DeepL API Key ↗" NavigateUri="https://www.deepl.com/pro-api" Padding="0" FontSize="11" />
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="Authentication Key" FontSize="12" />
                                                <PasswordBox x:Name="DeepLApiKeyInput" PlaceholderText="Paste your DeepL API key" PasswordChanged="OnKeyInputChanged" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="16">
                                                <RadioButton x:Name="DeepLFreeRadio" Content="Free Tier (api-free.deepl.com)" IsChecked="True" Checked="DeepLRadio_Checked" />
                                                <RadioButton x:Name="DeepLProRadio" Content="Pro Tier (api.deepl.com)" Checked="DeepLRadio_Checked" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Panel: Baidu -->
                                        <StackPanel x:Name="BaiduConfigPanel" Visibility="Collapsed" Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Baidu Fanyi (百度翻译) Configuration" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                                <HyperlinkButton Grid.Column="1" Content="Baidu Developer Portal ↗" NavigateUri="https://fanyi-api.baidu.com" Padding="0" FontSize="11" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="APP ID" FontSize="12" />
                                                    <TextBox x:Name="BaiduAppIdInput" PlaceholderText="Enter App ID" TextChanged="OnKeyInputChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="Secret Key (密钥)" FontSize="12" />
                                                    <PasswordBox x:Name="BaiduSecretKeyInput" PlaceholderText="Enter Secret Key" PasswordChanged="OnKeyInputChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Panel: Papago -->
                                        <StackPanel x:Name="PapagoConfigPanel" Visibility="Collapsed" Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Naver Papago (파파고) Configuration" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                                <HyperlinkButton Grid.Column="1" Content="Naver Cloud Console ↗" NavigateUri="https://www.ncloud.com" Padding="0" FontSize="11" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="Client ID" FontSize="12" />
                                                    <TextBox x:Name="PapagoClientIdInput" PlaceholderText="Enter Client ID" TextChanged="OnKeyInputChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="Client Secret" FontSize="12" />
                                                    <PasswordBox x:Name="PapagoClientSecretInput" PlaceholderText="Enter Client Secret" PasswordChanged="OnKeyInputChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Panel: Yandex -->
                                        <StackPanel x:Name="YandexConfigPanel" Visibility="Collapsed" Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Yandex Translate Configuration" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                                <HyperlinkButton Grid.Column="1" Content="Yandex Cloud Console ↗" NavigateUri="https://cloud.yandex.com" Padding="0" FontSize="11" />
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="API Key" FontSize="12" />
                                                <PasswordBox x:Name="YandexApiKeyInput" PlaceholderText="Enter API Key" PasswordChanged="OnKeyInputChanged" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Panel: Youdao -->
                                        <StackPanel x:Name="YoudaoConfigPanel" Visibility="Collapsed" Spacing="12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Youdao Translate (网易有道智云) Configuration" FontWeight="SemiBold" FontSize="13" Foreground="#38BDF8" />
                                                <HyperlinkButton Grid.Column="1" Content="Youdao AI Console ↗" NavigateUri="https://ai.youdao.com" Padding="0" FontSize="11" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <TextBlock Text="App Key (应用ID)" FontSize="12" />
                                                    <TextBox x:Name="YoudaoAppKeyInput" PlaceholderText="Enter 应用ID" TextChanged="OnKeyInputChanged" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="App Secret (应用密钥)" FontSize="12" />
                                                    <PasswordBox x:Name="YoudaoAppSecretInput" PlaceholderText="Enter 应用密钥" PasswordChanged="OnKeyInputChanged" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Action Bar -->
                                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" x:Name="TestConnectionButton" Click="TestConnectionButton_Click" Padding="14,6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8BD;" FontSize="12" Foreground="#38BDF8" />
                                                    <TextBlock Text="Test Connection" />
                                                </StackPanel>
                                            </Button>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <ProgressRing x:Name="TestProgressRing" Width="14" Height="14" IsActive="False" Visibility="Collapsed" />
                                                <TextBlock x:Name="TestResultStatusText" Text="Click Test to verify connection and check latency." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button Grid.Column="2" x:Name="SaveKeysButton" Content="Save Keys" Click="SaveKeysButton_Click" Background="#2563EB" Foreground="White" Padding="16,6" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Auto Fallback -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Smart Auto-Fallback on Rate Limit / Error" FontSize="13" />
                                        <TextBlock Text="If primary API fails (e.g. quota limit 429), silently fallback to Google / Bing" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutoFallbackToggle" Grid.Column="1" IsOn="True" Toggled="AutoFallbackToggle_Toggled" Margin="12,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── SECTION B: TRIGGER & SMART TRANSLATION + GAMING EXCLUSION ── -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: Trigger & Smart Bi-directional -->
                            <Border Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Trigger &amp; Smart Translation" FontWeight="SemiBold" FontSize="14" />

                                    <!-- Double-tap Ctrl -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Double-tap Ctrl Shortcut" FontSize="13" />
                                            <TextBlock Text="Tap Ctrl key twice quickly to trigger popup" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="HotkeyCtrlToggle" Grid.Column="1" IsOn="True" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Speed Window -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Double-tap Speed Window" FontSize="13" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fast (300ms)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Slider Grid.Column="1" x:Name="SpeedSlider" Minimum="300" Maximum="750" Value="550" ValueChanged="SpeedSlider_ValueChanged" />
                                            <TextBlock Grid.Column="2" Text="Slow (750ms)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Smart Bi-directional -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Smart Bi-directional Auto-Switch" FontSize="13" />
                                            <TextBlock Text="Automatically inverts language (e.g. English ➔ Chinese, Chinese ➔ English)" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="SmartBiDirectionalToggle" Grid.Column="1" IsOn="True" Toggled="SmartBiDirectionalToggle_Toggled" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Gaming & App Exclusion List (Blacklist) -->
                            <Border Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Gaming &amp; App Exclusion Blacklist" FontWeight="SemiBold" FontSize="14" />

                                    <!-- Fullscreen detection -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="Disable in Fullscreen Games" FontSize="13" />
                                            <TextBlock Text="Prevents accidental popups in games using Ctrl" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch x:Name="FullscreenExclusionToggle" Grid.Column="1" IsOn="True" Toggled="FullscreenExclusionToggle_Toggled" />
                                    </Grid>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                    <!-- Excluded Process Box -->
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Blacklisted Application Executables" FontSize="13" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="NewBlacklistProcessInput" PlaceholderText="e.g. game.exe or terminal.exe" Grid.Column="0" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Add" Click="AddBlacklistProcess_Click" />
                                        </Grid>
                                        <ScrollViewer MaxHeight="85" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                                            <ItemsControl x:Name="BlacklistItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8,4" Margin="0,2">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Tag="{Binding}" Click="RemoveBlacklistProcess_Click" Padding="4,2" Background="Transparent" BorderThickness="0">
                                                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ── SECTION C: SYSTEM STARTUP & BEHAVIOR ── -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="System &amp; Desktop Behavior" FontWeight="SemiBold" FontSize="14" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Launch at Windows startup" FontSize="13" />
                                        <TextBlock Text="Start DoubleTake silently in system tray on boot" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" IsOn="True" Toggled="StartupToggle_Toggled" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Close Window Minimizes to System Tray" FontSize="13" />
                                        <TextBlock Text="Keep DoubleTake active in notification area when closing window" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="MinimizeToTrayToggle" Grid.Column="1" IsOn="True" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Run Text="DoubleTake v1.0.7  ·  WinUI 3 + Windows App SDK 1.5" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
